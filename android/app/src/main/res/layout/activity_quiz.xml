<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/akcent" android:padding="12dp">
        <TextView android:id="@+id/txtPostep" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/pasek" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <TextView android:id="@+id/txtMeta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/szary" android:textSize="11sp" />

            <TextView android:id="@+id/txtPytanie" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/tekst" android:textSize="17sp" android:textStyle="bold" />

            <LinearLayout android:id="@+id/boxOdpowiedzi" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <LinearLayout android:id="@+id/boxWyjasnienie" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/tlo_karty" android:padding="12dp"
                android:layout_marginTop="14dp" android:visibility="gone">
                <TextView android:id="@+id/txtWerdykt" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtWyjasnienie" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textColor="@color/tekst" android:textSize="14sp" />
                <TextView android:id="@+id/txtPodstawa" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textColor="@color/szary" android:textSize="12sp" />
            </LinearLayout>

            <TextView android:id="@+id/txtWynik" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp"
                android:textColor="@color/tekst" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnDalej" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="DALEJ" android:textSize="16sp"
        android:background="@color/akcent" android:textColor="#FFFFFF" android:visibility="gone" />
</LinearLayout>
